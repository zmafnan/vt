on post-fs-data
    chown system system /sys/bus/i2c/drivers/awinic_haptic/0-005a/f0_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/0-005a/osc_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/0-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/0-005a/custom_wave
#MIUI MOD:Haptic_MIUIHapticFrame
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/0-006b/f0_save
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/0-006b/osc_save
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/0-006b/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/sih_haptic_688X/0-006b/custom_wave
    chown system system /sys/bus/i2c/drivers/awinic_haptic/0-005a/f0
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/0-005a/f0
    chown system system /sys/bus/i2c/drivers/haptic_rt/0-005f/f0_save
    chown system system /sys/bus/i2c/drivers/haptic_rt/0-005f/osc_save
    chown system system /sys/bus/i2c/drivers/haptic_rt/0-005f/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/haptic_rt/0-005f/custom_wave
#END Haptic_MIUIHapticFrame
#MIUI MOD:Haptic_MIUIHapticFrame
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/f0_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/osc_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/1-005a/custom_wave
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/1-006b/f0_save
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/1-006b/osc_save
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/1-006b/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/sih_haptic_688X/1-006b/custom_wave
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/f0
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/1-005a/f0
    chown system system /sys/class/leds/vibrator_r/custom_wave
    chmod 0666  /sys/class/leds/vibrator_r/custom_wave
    chown system system /sys/class/leds/vibrator_l/custom_wave
    chmod 0666  /sys/class/leds/vibrator_l/custom_wave
    chown system system /sys/class/leds/vibrator_l/awrw
    chmod 0666  /sys/class/leds/vibrator_l/awrw
    chown system system /sys/class/leds/vibrator_r/sample_param
    chmod 0666  /sys/class/leds/vibrator_r/sample_param
    chown system system /sys/class/leds/vibrator_r/brightness
    chmod 0666  /sys/class/leds/vibrator_r/brightness
#END Haptic_MIUIHapticFrame
#MIUI MOD:Haptic_MIUIHapticFrame
    # CIRRUS Haptic 3
    chown system system /sys/bus/i2c/drivers/cs40l26/1-0043/input/input3/calibration/redc_stored
    chown system system /sys/bus/i2c/drivers/cs40l26/1-0043/input/input3/calibration/f0_stored
    chown system system /sys/bus/i2c/drivers/cs40l26/1-0043/input/input3/calibration/q_stored
#END Haptic_MIUIHapticFrame
    # cal-file directory
    mkdir /mnt/vendor/persist/haptics 0755 system system

#MIUI MOD:Haptic_MIUIHapticFrame
    chown system system /dev/awinic_haptic
    chmod 0666 /dev/awinic_haptic
    chown system system /dev/awinic_x_haptic
    chmod 0666 /dev/awinic_x_haptic
#END Haptic_MIUIHapticFrame

    # FS Haptic 3002
    chown system system /sys/bus/i2c/drivers/fs_haptic/1-0076/f0_save
    chown system system /sys/bus/i2c/drivers/fs_haptic/1-0076/osc_save
    chown system system /sys/bus/i2c/drivers/fs_haptic/1-0076/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/fs_haptic/1-0076/custom_wave

service vibratorfeature-hal-service /vendor/bin/hw/vendor.xiaomi.hardware.vibratorfeature.service
    class hal
    user system
    group system input audio
    onrestart restart vibratorfeature
#MIUI MOD:Haptic_MIUIHapticFrame
